# Copy to .env and adjust as needed:
#   cp .env.example .env

# --- Auth Postgres ---
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=password
AUTH_DB_PORT=5432

# --- Exam Postgres ---
EXAM_DB_NAME=exam_db
EXAM_DB_USER=postgres
EXAM_DB_PASSWORD=password
EXAM_DB_PORT=5433

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASS=password
MONGO_DB=krakit-question
MONGO_PORT=27017

# --- Redis ---
REDIS_PASSWORD=password
REDIS_PORT=6379

# --- Kafka (host clients use EXTERNAL listener) ---
KAFKA_HOST=localhost
KAFKA_PORT=29092
KAFKA_UI_PORT=8080

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exams
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- App services (Docker) ---
AUTH_SERVICE_PORT=8081
EXAM_SERVICE_PORT=8082
TOKEN_SECRET=dev-token-secret-change-me
TOKEN_DURATION=15
GOOGLE_CLIENT_ID=

# --- Host-local service defaults (make auth / make exam) ---
# Prefer these when running Go services on the host against Docker infra.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=auth_db
REDIS_HOST=localhost
AUTH_SERVICE_JWKS=http://localhost:8081/api/v1/.well-known/jwks.json
MINIO_ENDPOINT=localhost:9000
